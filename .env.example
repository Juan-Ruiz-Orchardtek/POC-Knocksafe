# Copy to .env and adjust to your local MySQL
# cp .env.example .env   (Mac/Linux)
# copy .env.example .env (Windows)

# --- MySQL (your machine) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=knocksafe
# TypeORM creates/updates tables in dev (set false in production)
DB_SYNC=true

# --- Auth ---
JWT_SECRET=knocksafe-poc-dev-secret-change-in-prod

# --- Service URLs (local dev) ---
ORGANIZATIONS_SERVICE_URL=http://localhost:3002
REPS_SERVICE_URL=http://localhost:3003

# --- Frontends (optional) ---
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:3001
NEXT_PUBLIC_ORGS_SERVICE_URL=http://localhost:3002
NEXT_PUBLIC_REPS_SERVICE_URL=http://localhost:3003
